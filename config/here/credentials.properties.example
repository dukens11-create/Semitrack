# Copy this file to credentials.properties in the same directory, then replace
# every placeholder with the matching value from the credentials file
# downloaded from HERE Access Manager. Never commit the populated file.
here.user.id=YOUR_HERE_USER_ID
here.client.id=YOUR_HERE_CLIENT_ID
here.access.key.id=YOUR_HERE_ACCESS_KEY_ID
here.access.key.secret=YOUR_HERE_ACCESS_KEY_SECRET
here.token.endpoint.url=YOUR_HERE_TOKEN_ENDPOINT_URL
