NODE_ENV=development
APP_VERSION=1.0.0
APP_BUILD_SHA=
ANALYTICS_PRESENCE_MINUTES=5
ANALYTICS_NAVIGATION_STALE_MINUTES=2
ANALYTICS_DRIVING_THRESHOLD_MINUTES=660
PORT=4000
# For Neon runtime traffic, use the pooled hostname ending in -pooler and keep full TLS verification enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/semitrack?sslmode=verify-full&channel_binding=require
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173

# Subscription foundation. Keep disabled until Phase 2 migrations are applied
# and an administrator intentionally enables test-only mutations.
BILLING_MODE=disabled
PUBLIC_API_URL=
# Set these to complete HTTPS URLs; dotenv does not expand PUBLIC_API_URL.
GOOGLE_RTDN_WEBHOOK_URL=
APPLE_NOTIFICATIONS_URL=
STRIPE_WEBHOOK_URL=

# Google Play placeholders. Provider activation and credentials are pending.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=semitrax_premium
GOOGLE_PLAY_MONTHLY_BASE_PLAN_ID=monthly
GOOGLE_PLAY_ANNUAL_BASE_PLAN_ID=annual
GOOGLE_PLAY_TRIAL_OFFER_ID=trial_7_day
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_TOPIC=
GOOGLE_PLAY_PUBSUB_SUBSCRIPTION=

# Apple placeholders. Bundle/application/team identifiers must not be invented.
APPLE_BUNDLE_ID=
APPLE_SUBSCRIPTION_GROUP_NAME=Semi-Trax Premium
APPLE_MONTHLY_PRODUCT_ID=com.semitrax.premium.monthly
APPLE_ANNUAL_PRODUCT_ID=com.semitrax.premium.annual
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Pilot invitations reserve at most 100 Founding 100 slots. Invitation tokens
# are generated by the API and only their SHA-256 hashes are stored.
PILOT_CAMPAIGN_CODE=FOUNDING_100
PILOT_MAX_REDEMPTIONS=100
PILOT_DISCOUNT_MONTHS=6
PILOT_RESERVATION_MINUTES=10080
ENTITLEMENT_OFFLINE_CACHE_HOURS=24
ENTITLEMENT_NEGATIVE_CACHE_MINUTES=5

# Public/legal URLs. Keep the Render fallback until the custom domain and all
# legal pages have valid HTTPS and are verified live.
WEBSITE_URL=https://www.semitrax.com
PRIVACY_POLICY_URL=https://www.semitrax.com/privacy.html
TERMS_OF_SERVICE_URL=https://www.semitrax.com/terms.html
SUPPORT_EMAIL=contact@semitrax.com
TEMPORARY_WEBSITE_FALLBACK=https://semitrax-website.onrender.com
HERE_API_KEY=
MAPBOX_TOKEN=
# Production architecture: Trimble/PC*Miler owns commercial truck route
# planning. TomTom owns native on-device guidance. HERE remains available only
# as a temporary comparison/fallback while the Trimble + TomTom flow is proven.
ROUTING_PROVIDER=trimble
# Enables the developer-only HERE/Trimble comparison endpoint.
ROUTING_COMPARE_ENABLED=false
TRIMBLE_API_KEY=
TRIMBLE_BASE_URL=https://pcmiler.alk.com/apis/rest/v1.0/Service.svc
TRIMBLE_DATA_VERSION=Current
# Optional: only set this to the exact name of a routing profile created in
# your Trimble account. The explicit TruckCfg fields below do not require it.
TRIMBLE_PROFILE_NAME=
# GeoTunnel works with standard Route Reports. Keep this at Trimble's 0.1-mile minimum.
TRIMBLE_GEOTUNNEL_INTERVAL_MILES=0.1
TRIMBLE_REQUEST_TIMEOUT_MS=15000
# These require the applicable Trimble Maps / Alternate Routes entitlements.
# Required for navigation-quality geometry that follows the routed truck road.
# If the key lacks the Trimble Maps/RoutePath entitlement, routing fails safely
# instead of drawing straight GeoTunnel chords across non-routable streets.
TRIMBLE_ROUTE_PATH_ENABLED=true
TRIMBLE_ALTERNATE_ROUTES_ENABLED=false
# JSON array of official DOT/511 adapters. Endpoints and optional auth-header
# environment-variable names only; do not embed API keys in the JSON.
DOT_PROVIDER_CONFIG_JSON=[]
# Optional OpenStreetMap road-control source used for traffic signals and
# physical sign locations when HERE Map Attributes is not entitled/available.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
PASSWORD_RESET_BASE_URL=
ELD_ENCRYPTION_KEY=
SAMSARA_CLIENT_ID=
SAMSARA_CLIENT_SECRET=
SAMSARA_REDIRECT_URI=
MOTIVE_CLIENT_ID=
MOTIVE_CLIENT_SECRET=
MOTIVE_REDIRECT_URI=
# Stripe remains backend-only and test-mode-only until separately approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=7
STRIPE_GRACE_PERIOD_DAYS=3
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Comma-separated canonical HTTPS origins only; no wildcard or trailing slash.
STRIPE_ALLOWED_WEB_ORIGINS=
STRIPE_PRODUCT_INDIVIDUAL_ID=
STRIPE_PRICE_INDIVIDUAL_MONTHLY_ID=
STRIPE_PRICE_INDIVIDUAL_ANNUAL_ID=
STRIPE_PRICE_PILOT_MONTHLY_ID=
STRIPE_PRODUCT_FLEET_ID=
STRIPE_PRICE_FLEET_1_4_ID=
STRIPE_PRICE_FLEET_5_24_ID=
STRIPE_PRICE_FLEET_25_99_ID=
STRIPE_PORTAL_CONFIGURATION_INDIVIDUAL_ID=
STRIPE_PORTAL_CONFIGURATION_FLEET_ID=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
FLEET_SALES_EMAIL=contact@semitrax.com
FLEET_CONTACT_URL=https://www.semitrax.com/#contact
FLEET_CONTACT_FALLBACK_MAILTO=mailto:contact@semitrax.com?subject=Semi-Trax%20Fleet%20Subscription
AWS_REGION=
S3_BUCKET=
