<resources>
    <!-- Android 12+ uses the platform icon splash, then the full branded RN splash. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@drawable/semitrax_launch_background</item>
        <item name="android:windowSplashScreenBackground">#40464C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#40464C</item>
        <!-- React owns appearance; Android must not recolor explicit Day. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
