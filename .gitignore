# Miscellaneous
*.class
*.log
*.tsbuildinfo
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# Node.js dependencies
node_modules/
**/node_modules/
**/dist/
.npm-cache-*/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
/build/

# Local Android recovery/build caches
/.android-codex/
/.gradle-codex*/
/build-codex*/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build
/android/.gradle
/android/local.properties
/android/captures
.externalNativeBuild
.cxx

# Proprietary HERE SDK and local credentials (install per docs/HERE_EXPLORE_SETUP.md)
/plugins/here_sdk/
/heresdk-*.tar.gz
/heresdk-*.zip
/credentials.properties
/here_credentials.env
/config/here/credentials.properties
/config/here/credentials.json
/config/mapbox/credentials.properties

# Local application/server environment files. Keep documented templates.
.env
.env.*
!.env.example
!**/.env.example

# iOS related - generated build artifacts only (keep source files)
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/

# Generated plugin registrant files
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
ios/Flutter/ephemeral/
ios/Runner/GeneratedPluginRegistrant.h
ios/Runner/GeneratedPluginRegistrant.m
